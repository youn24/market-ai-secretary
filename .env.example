# Telegram通知（任意）
TELEGRAM_BOT_TOKEN=ここにBotFatherのトークン
TELEGRAM_CHAT_ID=ここにあなたのChat ID

# iPhone通知（ntfy.sh - 無料・APIキー不要）
# iPhoneのApp Storeで「ntfy」をインストール後、トピック名を設定
# 例: market-secretary-yamada2024（世界でユニークな名前にすること）
NTFY_TOPIC=ここにトピック名（例: market-nakata-2024）

# Ollamaモデルパス（日本語ユーザー名の場合は必須）
OLLAMA_MODELS=C:\ollama_models
