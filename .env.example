# Telegram通知（任意）
TELEGRAM_BOT_TOKEN=ここにBotFatherのトークン
TELEGRAM_CHAT_ID=ここにあなたのChat ID

# iPhone通知（ntfy.sh - 無料・APIキー不要）
# iPhoneのApp Storeで「ntfy」をインストール後、トピック名を設定
# 例: market-secretary-yamada2024（世界でユニークな名前にすること）
NTFY_TOPIC=ここにトピック名（例: market-nakata-2024）

# Ollamaモデルパス（日本語ユーザー名の場合は必須）
OLLAMA_MODELS=C:\ollama_models

# ── HTMLメール（文章の間に画像を挟んだ記事を届ける）──
# Gmailを使う場合、**通常のログインパスワードでは送れません**。
# 2段階認証を有効にしたうえで「アプリパスワード」を発行して貼ってください。
#   発行先: https://myaccount.google.com/apppasswords
# ⚠️ この .env は .gitignore 済みです。アプリパスワードは絶対にコミットしない。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=送信に使うGmailアドレス
SMTP_PASS=ここにアプリパスワード（16文字・空白は詰めてよい）
MAIL_TO=受け取りたいアドレス（iPhoneで見るもの）
MAIL_FROM=省略可。空なら SMTP_USER が使われます
